---

<BaseLayout
  title={`${profile.name} — Software Engineer`}
  description="Sumon Ray — software engineer in Dhaka. PHP/Laravel, MySQL, APIs, e-commerce and business systems. Open to new roles."
  canonicalPath="/"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profile.name,
    jobTitle: 'Software Engineer',
    url: Astro.site ?? 'https://sshanto13.github.io',
    image: new URL(profile.photoSrc, Astro.site ?? 'https://sshanto13.github.io').toString(),
    email: `mailto:${profile.email}`,
    telephone: profile.phone,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Dhaka',
      addressCountry: 'BD',
    },
    sameAs: [profile.links.github, profile.links.linkedin, profile.links.facebook],
  }}
>
  <header class="site-nav" id="siteNav">
    <nav class="fk-nav container" aria-label="Primary">
      <a class="fk-nav-brand" href="#top" aria-label="Sumon Ray home">
        <span class="fk-nav-logo">Sumon Ray</span>
      </a>

      <div class="fk-nav-links" id="navLinks">
        <a class="fk-nav-link" href="#about">About</a>
        <a class="fk-nav-link" href="#projects">Projects</a>
        <a class="fk-nav-link" href="#experience">Experience</a>
        <a class="fk-nav-link" href="#skills">Skills</a>
      </div>

      <a class="fk-nav-contact" href="#contact">Contact</a>

      <button class="fk-theme-toggle" type="button" aria-label="Switch to dark mode" title="Toggle theme">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5z"></path>
        </svg>
      </button>

      <button class="fk-nav-toggle" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="navLinks">
        <span></span><span></span><span></span>
      </button>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <div class="container">
        <div class="row g-4 align-items-center">
          <div class="col-lg-5 order-1 order-lg-2">
            <div class="profile reveal is-in">
              <div class="profile-frame">
                <img src={profile.photoSrc} alt={`${profile.name} profile photo`} loading="eager" />
              </div>
              <div class="mt-3 social">
                <a class="link-btn" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
                  <i class="fa fa-linkedin" aria-hidden="true"></i> LinkedIn
                </a>
                <a class="link-btn" href={profile.links.github} target="_blank" rel="noopener noreferrer">
                  <i class="fa fa-github" aria-hidden="true"></i> GitHub
                </a>
              </div>
            </div>
          </div>

          <div class="col-lg-7 order-2 order-lg-1">
            <div class="hero-card reveal is-in">
              <span class="hero-kicker">Dhaka · open to the next role</span>

              <p class="hero-name">{profile.name}</p>
              <p class="hero-role">{profile.title}</p>
              <h1 class="hero-title">
                I build software people at work can <em>actually run</em>.
              </h1>
              <p class="hero-lead">
                8+ years turning real-world requirements into web applications, APIs, business systems, and automation
                solutions across different industries and business environments.
              </p>
              <p class="hero-lead hero-lead-follow">
                I work across the stack when needed—from backend and APIs to frontend, databases, infrastructure,
                reporting, and AI-assisted development.
              </p>

              <div class="hero-actions">
                <a class="btn-primary-neo" href="#contact">Get in touch</a>
                <a class="btn-ghost" href={profile.resumeUrl} target="_blank" rel="noopener noreferrer">View Resume</a>
                <a class="btn-ghost" href="#projects">See projects</a>
              </div>

              <div class="stat-row stat-row-impact" aria-label="quick stats">
                {stats.map((s) => (
                  <div class="stat stat-lg">
                    <strong>{s.value}</strong>
                    <span>{s.label}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section about-section" id="about" aria-labelledby="about-heading">
      <div class="container about-shell">
        <div class="about-card reveal">
          <div class="about-card-top">
            <div>
              <p class="about-card-kicker">About</p>
              <h2 class="about-card-title" id="about-heading">About Me</h2>
            </div>
            <div class="about-card-meta">
              <span>{profile.location}</span>
              <span class="about-card-dot" aria-hidden="true"></span>
              <span>Open to new opportunities</span>
            </div>
          </div>

          <div class="about-card-body">
            <p class="about-card-lead">
              I’m a Software Engineer with 8+ years of experience building practical software solutions for real-world
              business operations.
            </p>

            <div class="about-card-copy">
              <p>
                My experience spans software companies, enterprise systems, e-commerce, government ICT, and travel &amp;
                property management. At NYBSYS Inc and ADN Telecom PLC, I worked on software products, enterprise
                applications, APIs, and ICT systems, building a strong foundation in professional software development
                and working with different technical and business requirements.
              </p>
              <p>
                My 4+ years with PaiMart, previously known as Paikaree.com.bd and backed by JS Enterprise, were
                particularly valuable in understanding how a complete business platform works—not just the software, but
                the business behind it. I worked across e-commerce, sales, distribution, inventory, orders, payments,
                ERP/POS, reporting, APIs, and business workflows, gaining a strong understanding of how technology
                supports day-to-day business operations.
              </p>
              <p>
                At Destinique Travel LLC, I work on business automation and digital solutions covering booking, property
                management, ad generation, promotions, visitor tracking, monitoring, APIs, dashboards, and operational
                workflows.
              </p>
              <p>
                My strongest technical ground is PHP, Laravel, SQL, MySQL, PostgreSQL, JavaScript, and REST APIs, with
                experience across Angular, Vue, React, Node.js, Python, cloud/VPS infrastructure, Docker, and AI-assisted
                development.
              </p>
              <p>
                I also have experience with data, BI dashboards, reporting, business automation, and digital
                transformation, giving me a broader understanding of how technology can improve business processes,
                operational efficiency, and decision-making.
              </p>
              <p>
                What I enjoy most is working where technology and business come together—understanding the problem,
                finding a practical solution, building it, and seeing it work in the real world.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="skills">
      <div class="container">
        <header class="section-head reveal">
          <p class="section-kicker">Skills</p>
          <h2 class="section-lead">What I bring to your team</h2>
          <p class="section-desc">
            Building practical software solutions across <strong>full-stack development, business applications, APIs,
            automation, data, and ICT systems</strong>, with <strong>8+ years of hands-on experience</strong> from
            development through production delivery.
          </p>
        </header>

        <div class="skill-rows reveal">
          {skillTabs.map((tab) => (
            <div class="skill-row">
              <div class="skill-row-label">{tab.label}</div>
              <div class="skill-row-values">
                <div class="chip-row chip-row-compact">
                  {tab.skills.map((s) => (
                    <span class="chip chip-compact">{s}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section-experience" id="experience">
      <div class="container py-5">
        <div class="row mb-5">
          <div class="col text-center reveal">
            <p class="section-kicker">Experience</p>
            <h2 class="exp-section-title">Where I’ve shipped</h2>
            <p class="exp-section-sub">E-commerce, travel ops, telecom/ICT, and international project work.</p>
          </div>
        </div>

        <div class="timeline">
          {experience.map((e) => (
            <div class="timeline-item mb-5 reveal">
              <span class="timeline-dot"></span>
              <article class="card exp-card border-0 shadow-sm p-4 ml-3">
                <div class="d-flex align-items-center mb-3 exp-card-head">
                  {e.logo ? (
                    <img src={e.logo} alt="" width="48" height="48" class="rounded exp-logo" loading="lazy" />
                  ) : (
                    <div class="exp-logo-fallback rounded" aria-hidden="true">
                      {e.company.charAt(0)}
                    </div>
                  )}
                  <div>
                    <h3 class="exp-role mb-0">{e.title}</h3>
                    <span class="exp-company">
                      {e.companyUrl ? (
                        <a href={e.companyUrl} class="text-decoration-none" target="_blank" rel="noopener noreferrer">
                          {e.company}
                        </a>
                      ) : (
                        e.company
                      )}
                    </span>
                  </div>
                </div>
                <div class="text-muted small mb-3">
                  {e.start} – {e.end} · {e.location}
                </div>
                <p class="mb-3 exp-summary">{e.summary}</p>
                <h4 class="exp-achievements-label">What I worked on</h4>
                <ul class="mb-3 exp-bullets">
                  {e.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                {e.stack?.length ? (
                  <div class="d-flex flex-wrap exp-badges">
                    {e.stack.map((s) => (
                      <span class="badge exp-badge">{s}</span>
                    ))}
                  </div>
                ) : null}
              </article>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt" id="projects">
      <div class="container">
        <header class="project-section-head reveal">
          <p class="section-kicker">Projects</p>
          <h2 class="section-lead">Selected work</h2>
          <p class="section-desc">
            A selection of projects that showcase practical software for business operations, automation, and delivery.
          </p>
        </header>

        <div class="project-showcase">
          {featuredProjects.map((p) => {
            const visibleStack = p.stack.slice(0, 5);
            const moreCount = Math.max(0, p.stack.length - visibleStack.length);
            const detailUrl = `${baseUrl}projects/${p.slug}/`;
            return (
              <article class="project-card reveal">
                <div class="project-card-media">
                  <a href={detailUrl} class="project-card-image-link">
                    <img src={p.image} alt={`${p.title} screenshot`} loading="lazy" />
                  </a>
                </div>
                <div class="project-card-body">
                  <h3 class="project-card-title">
                    <a href={detailUrl} class="project-card-title-link">{p.title}</a>
                  </h3>
                  <p class="project-card-company">{p.company}</p>
                  <p class="project-card-desc">{p.description}</p>
                  <div class="project-card-tags" aria-label="tech stack">
                    {visibleStack.map((s) => (
                      <span class="project-tag">{s}</span>
                    ))}
                    {moreCount > 0 ? <span class="project-tag project-tag-more">+{moreCount} more</span> : null}
                  </div>
                  <div class="project-card-actions">
                    <a class="link-btn" href={detailUrl}>
                      Details
                    </a>
                    {p.liveUrl ? (
                      <a class="link-btn" href={p.liveUrl} target="_blank" rel="noopener noreferrer">
                        <i class="fa fa-external-link" aria-hidden="true"></i> Live <span class="sr-only">(opens in a new tab)</span>
                      </a>
                    ) : null}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="section" id="what-i-do">
      <div class="container">
        <header class="section-head reveal">
          <p class="section-kicker">Capabilities</p>
          <h2 class="section-lead">What I Do</h2>
          <p class="section-desc">The kinds of work I usually end up doing.</p>
        </header>
        <div class="row">
          {whatIDo.map((item) => (
            <div class="col-md-6 col-lg-4 mb-4 reveal">
              <div class="service-card h-100">
                <h3 class="service-title">{item.title}</h3>
                <p class="service-text">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt" id="beyond-coding">
      <div class="container">
        <header class="section-head reveal">
          <p class="section-kicker">Beyond the IDE</p>
          <h2 class="section-lead">Beyond Coding</h2>
          <p class="section-desc">
            Writing features is only part of it — a lot of the job is process, data, and people.
          </p>
        </header>
        <div class="row">
          {beyondCoding.map((item) => (
            <div class="col-md-6 col-lg-4 mb-4 reveal">
              <div class="skill-box h-100">
                <h3>{item.title}</h3>
                <div class="small-muted">{item.text}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="how-i-work">
      <div class="container">
        <header class="section-head reveal">
          <p class="section-kicker">Process</p>
          <h2 class="section-lead">How I Work</h2>
          <p class="section-desc">I like understanding the problem before locking in a technical approach.</p>
        </header>
        <div class="hero-card work-process reveal">
          <div class="work-steps" aria-label="Work process">
            <span class="work-step">Understand</span>
            <span class="work-step-arrow" aria-hidden="true">→</span>
            <span class="work-step">Build</span>
            <span class="work-step-arrow" aria-hidden="true">→</span>
            <span class="work-step">Check</span>
            <span class="work-step-arrow" aria-hidden="true">→</span>
            <span class="work-step">Ship</span>
            <span class="work-step-arrow" aria-hidden="true">→</span>
            <span class="work-step">Fix</span>
          </div>
          <div class="work-copy">
            <p>
              I aim for something the team can actually use and maintain — not just something that demos well once.
            </p>
            <p>
              Fine taking a feature from “we need this” through development, testing help, deploy support, and later
              tweaks when real usage shows gaps.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="education">
      <div class="container">
        <header class="section-head reveal">
          <p class="section-kicker">Background</p>
          <h2 class="section-lead">Education</h2>
          <p class="section-desc">Degree plus professional training that shaped how I build software.</p>
        </header>

        <div class="row">
          {education.map((e) => (
            <div class="col-md-4 mb-4 reveal">
              <div class="hero-card h-100 edu-card">
                <div class="edu-card-top">
                  <div class="small-muted">Education</div>
                  <div class="chip">{e.time}</div>
                </div>
                <h3 class="item-title">{e.degree}</h3>
                <div class="small-muted" style="margin-top:4px;">{e.org}</div>
              </div>
            </div>
          ))}
          {training.map((e) => (
            <div class="col-md-4 mb-4 reveal">
              <div class="hero-card h-100 edu-card">
                <div class="edu-card-top">
                  <div class="small-muted">{e.kind}</div>
                  <div class="chip">{e.time}</div>
                </div>
                <h3 class="item-title">{e.degree}</h3>
                <div class="small-muted" style="margin-top:4px;">{e.org}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section cta-band" id="hire">
      <div class="container reveal">
        <p class="section-eyebrow">Start here</p>
        <h2 class="cta-title">
          Bring me the problem.<br />
          I’ll help ship a fix.
        </h2>
        <p class="section-subtitle" style="margin-bottom:20px;">
          A slow report, an ops process stuck in spreadsheets, an API that keeps breaking, a Laravel app that needs
          someone who’s lived in production. Tell me what you’re trying to fix.
        </p>
        <div class="hero-actions">
          <a class="btn-primary-neo" href={`mailto:${profile.email}`}>Email me</a>
          <a class="btn-ghost" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a class="btn-ghost" href={profile.resumeUrl} target="_blank" rel="noopener noreferrer">View Resume</a>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="contact">
      <div class="container">
        <header class="section-head reveal">
          <p class="section-kicker">Contact</p>
          <h2 class="section-lead">Let’s talk</h2>
          <p class="section-desc">Recruiter, tech lead, or founder — skip the long pitch and say what you need.</p>
        </header>

        <div class="row g-4">
          <div class="col-lg-5 reveal">
            <div class="hero-card">
              <div class="contact-line">
                <span class="small-muted">Email</span>
                <a href={`mailto:${profile.email}`}>{profile.email}</a>
              </div>
              <div class="contact-line">
                <span class="small-muted">Phone</span>
                <span>{profile.phone}</span>
              </div>
              <div class="contact-line">
                <span class="small-muted">LinkedIn</span>
                <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">linkedin.com/in/sshanto13</a>
              </div>
              <div class="contact-line">
                <span class="small-muted">GitHub</span>
                <a href={profile.links.github} target="_blank" rel="noopener noreferrer">github.com/sshanto13</a>
              </div>
              <div class="contact-line" style="margin-bottom:0;">
                <span class="small-muted">Location</span>
                <span>{profile.location}</span>
              </div>
            </div>
          </div>
          <div class="col-lg-7 reveal">
            <div class="hero-card">
              <h3 class="item-title" style="margin-bottom:12px;">Where I’m Most Useful</h3>
              <ul class="useful-list">
                {usefulFor.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-start gap-2">
      <div>
        <div style="font-weight:800;">{profile.name}</div>
        <div class="small-muted">Software engineer · {profile.location}</div>
      </div>
      <div class="small-muted">© {year}</div>
    </div>
  </footer>
</BaseLayout>
