---

<BaseLayout
  title={`${profile.name} — Software Engineer | Full-Stack, Backend & Business Applications`}
  description="Software Engineer with 8+ years experience building web applications, business systems, APIs, automation, and ICT solutions. Strong PHP/Laravel foundation with working knowledge of Node.js and Python."
  canonicalPath="/"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profile.name,
    jobTitle: 'Software Engineer',
    url: Astro.site ?? 'https://sshanto13.github.io',
    image: new URL(profile.photoSrc, Astro.site ?? 'https://sshanto13.github.io').toString(),
    email: `mailto:${profile.email}`,
    telephone: profile.phone,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Dhaka',
      addressCountry: 'BD',
    },
    sameAs: [profile.links.github, profile.links.linkedin, profile.links.facebook],
  }}
>
  <div class="compare-banner">
    Previous draft for comparison · <a href={baseUrl}>Back to current homepage</a>
  </div>
  <header class="site-nav">
    <nav class="container nav-inner navbar navbar-expand-lg navbar-light">
      <a class="brand" href="#top">
        <span class="brand-badge">SR</span>
        <span>{profile.name}</span>
      </a>

      <button
        class="navbar-toggler"
        type="button"
        data-toggle="collapse"
        data-target="#navLinks"
        aria-controls="navLinks"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navLinks">
        <ul class="navbar-nav ml-auto">
          <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
          <li class="nav-item"><a class="nav-link" href="#what-i-do">What I Do</a></li>
          <li class="nav-item"><a class="nav-link" href="#skills">Skills</a></li>
          <li class="nav-item"><a class="nav-link" href="#experience">Experience</a></li>
          <li class="nav-item"><a class="nav-link" href="#projects">Projects</a></li>
          <li class="nav-item"><a class="nav-link" href="#opportunities">Opportunities</a></li>
          <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
          <li class="nav-item">
            <a class="nav-link" href={profile.resumeUrl} target="_blank" rel="noreferrer">CV</a>
          </li>
        </ul>
      </div>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <div class="container">
        <div class="row g-4 align-items-center">
          <div class="col-lg-5 order-1 order-lg-2">
            <div class="profile">
              <div class="profile-frame">
                <img src={profile.photoSrc} alt={`${profile.name} profile photo`} loading="eager" />
              </div>
              <div class="mt-3 social">
                <a class="link-btn" href={profile.links.linkedin} target="_blank" rel="noreferrer">
                  <i class="fa fa-linkedin" aria-hidden="true"></i> LinkedIn
                </a>
                <a class="link-btn" href={profile.links.github} target="_blank" rel="noreferrer">
                  <i class="fa fa-github" aria-hidden="true"></i> GitHub
                </a>
              </div>
            </div>
          </div>

          <div class="col-lg-7 order-2 order-lg-1">
            <div class="hero-card">
              <span class="hero-kicker">
                <i class="fa fa-briefcase" aria-hidden="true"></i>
                Open to New Opportunities
              </span>

              <h1 class="hero-title">{profile.name}</h1>
              <p class="hero-role">{profile.title}</p>
              <p class="hero-focus">{profile.focus}</p>
              <p class="hero-lead">
                Software Engineer with <strong>8+ years</strong> of experience building web applications, business
                systems, APIs, dashboards, and digital solutions for local and global clients.
              </p>
              <p class="hero-lead">
                Experience covers software development, backend and full-stack engineering, e-commerce, ERP/POS,
                business automation, reporting, data-driven applications, enterprise systems, and ICT solutions.
              </p>
              <p class="hero-lead">{profile.location} · Open to New Opportunities</p>

              <div class="hero-actions">
                <a class="btn-primary-neo" href="#projects">
                  <i class="fa fa-briefcase" aria-hidden="true"></i> View Projects
                </a>
                <a class="btn-ghost" href={profile.resumeUrl} target="_blank" rel="noreferrer">
                  <i class="fa fa-download" aria-hidden="true"></i> Download CV
                </a>
                <a class="btn-ghost" href={profile.links.linkedin} target="_blank" rel="noreferrer">
                  <i class="fa fa-linkedin" aria-hidden="true"></i> LinkedIn
                </a>
                <a class="btn-ghost" href={profile.links.github} target="_blank" rel="noreferrer">
                  <i class="fa fa-github" aria-hidden="true"></i> GitHub
                </a>
              </div>

              <div class="stat-row" aria-label="quick stats">
                {stats.map((s) => (
                  <div class="stat">
                    <strong>{s.value}</strong>
                    <span>{s.label}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="about">
      <div class="container">
        <h2 class="section-title">About Me</h2>
        <p class="section-subtitle">
          I am a Software Engineer with more than 8 years of experience building and maintaining software for real-world
          business operations.
        </p>
        <p class="section-subtitle" style="margin-top:-10px;">
          I started my career in web development and gradually moved into backend engineering, full-stack development,
          business applications, APIs, ERP/POS, e-commerce platforms, reporting systems, and workflow automation.
        </p>
        <p class="section-subtitle" style="margin-top:-10px;">
          Over the years, I have worked with development teams, business stakeholders, and international clients on
          systems where reliability, data accuracy, performance, and maintainability matter.
        </p>
        <p class="section-subtitle" style="margin-top:-10px;">
          My strongest technical background is in PHP/Laravel, OOP, SQL, MySQL/PostgreSQL, JavaScript, REST APIs, and
          database-driven applications. I also have experience with Angular, React, Vue, cloud/VPS environments,
          analytics, dashboards, and modern AI-assisted development tools.
        </p>
        <p class="section-subtitle" style="margin-top:-10px;">
          Strong production experience with PHP/Laravel, with working knowledge of Node.js and Python and the ability to
          adapt quickly to new backend technologies—building on solid OOP, API, and database fundamentals.
        </p>
        <p class="section-subtitle" style="margin-top:-10px;">
          I am currently open to opportunities where I can contribute not only as a developer, but also in business
          systems, automation, digital transformation, data/reporting, and broader ICT initiatives.
        </p>
      </div>
    </section>

    <section class="section" id="what-i-do">
      <div class="container">
        <h2 class="section-title">What I Do</h2>
        <p class="section-subtitle">
          Capability areas I bring to software and business-technology roles—not a tool list.
        </p>
        <div class="row">
          {whatIDo.map((item, i) => (
            <div class="col-md-6 col-lg-4 mb-4">
              <div class="service-card h-100">
                <div class="service-index">{String(i + 1).padStart(2, '0')}</div>
                <h3 class="service-title">{item.title}</h3>
                <p class="service-text">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt" id="skills">
      <div class="container">
        <h2 class="section-title">Technical Skills</h2>
        <p class="section-subtitle">
          Tools and technologies I use day to day across backend, frontend, data, cloud, and delivery.
        </p>
        <div class="skill-grid">
          {skillGroups.map((g) => (
            <div class="skill-box">
              <h3>{g.title}</h3>
              <div class="chip-row">
                {g.skills.map((s) => (
                  <span class="chip">{s}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section-experience" id="experience">
      <div class="container py-5">
        <div class="row mb-5">
          <div class="col text-center">
            <h2 class="exp-section-title">Work Experience</h2>
            <p class="exp-section-sub">
              Designed and developed scalable enterprise software systems, optimized backend performance, and delivered
              secure platforms for e-commerce, travel, business operations, and ICT solutions.
            </p>
          </div>
        </div>

        <div class="timeline">
          {experience.map((e) => (
            <div class="timeline-item mb-5">
              <span class="timeline-dot"></span>
              <div class="card exp-card border-0 shadow-sm p-4 ml-3">
                <div class="d-flex align-items-center mb-3 exp-card-head">
                  {e.logo ? (
                    <img src={e.logo} alt={e.company} width="48" height="48" class="rounded exp-logo" loading="lazy" />
                  ) : (
                    <div class="exp-logo-fallback rounded" aria-hidden="true">
                      {e.company.charAt(0)}
                    </div>
                  )}
                  <div>
                    <h5 class="exp-role mb-0">{e.title}</h5>
                    <span class="exp-company">
                      {e.companyUrl ? (
                        <a href={e.companyUrl} class="text-decoration-none" target="_blank" rel="noreferrer">
                          {e.company}
                        </a>
                      ) : (
                        e.company
                      )}
                    </span>
                  </div>
                </div>
                <div class="text-muted small mb-3">
                  {e.start} – {e.end} · {e.location}
                </div>
                <p class="mb-3 exp-summary">{e.summary}</p>
                <h6 class="exp-achievements-label">Key Achievements</h6>
                <ul class="mb-3 exp-bullets">
                  {e.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                {e.stack?.length ? (
                  <div class="d-flex flex-wrap exp-badges">
                    {e.stack.map((s) => (
                      <span class="badge exp-badge">{s}</span>
                    ))}
                  </div>
                ) : null}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt" id="projects">
      <div class="container">
        <h2 class="section-title">Featured Projects</h2>
        <p class="section-subtitle">
          Production work across travel, e-commerce, ERP, business operations, and government ICT.
        </p>

        <div class="row g-4">
          {featuredProjects.map((p) => (
            <div class="col-md-6 col-lg-4">
              <article class="card-neo">
                <div class="card-media">
                  <img src={p.image} alt={`${p.title} screenshot`} loading="lazy" />
                </div>
                <div class="card-body-neo">
                  <h3 class="card-title-neo">{p.title}</h3>
                  {p.category ? <div class="small-muted" style="margin-bottom:10px;">{p.category}</div> : null}
                  {p.role ? (
                    <div class="small-muted" style="margin-bottom:10px;">
                      Role: <strong>{p.role}</strong>
                    </div>
                  ) : null}
                  <div class="chip-row" aria-label="tech stack">
                    {p.stack.map((s) => (
                      <span class="chip">{s}</span>
                    ))}
                  </div>
                  <div class="card-actions">
                    {p.liveUrl ? (
                      <a class="link-btn" href={p.liveUrl} target="_blank" rel="noreferrer">
                        <i class="fa fa-external-link" aria-hidden="true"></i> Live
                      </a>
                    ) : null}
                    {p.repoUrl ? (
                      <a class="link-btn" href={p.repoUrl} target="_blank" rel="noreferrer">
                        <i class="fa fa-github" aria-hidden="true"></i> Code
                      </a>
                    ) : null}
                  </div>
                </div>
              </article>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="beyond-coding">
      <div class="container">
        <h2 class="section-title">Beyond Coding</h2>
        <p class="section-subtitle">
          Experience goes beyond writing application code—working closely with business processes, operational teams,
          databases, APIs, infrastructure, reporting, and production systems.
        </p>
        <div class="row">
          {beyondCoding.map((item) => (
            <div class="col-md-6 col-lg-4 mb-4">
              <div class="skill-box h-100">
                <h3>{item.title}</h3>
                <div class="small-muted">{item.text}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt" id="how-i-work">
      <div class="container">
        <h2 class="section-title">How I Work</h2>
        <p class="section-subtitle">
          I prefer understanding the business problem before deciding on the technical solution.
        </p>
        <div class="hero-card">
          <p class="hero-lead" style="margin:0 0 12px;">
            My typical approach is: <strong>Understand → Analyze → Design → Build → Test → Deploy → Improve</strong>
          </p>
          <p class="hero-lead" style="margin:0 0 12px;">
            I focus on solutions that are practical, maintainable, secure, and useful for the people who actually use
            them.
          </p>
          <p class="hero-lead" style="margin:0;">
            I am comfortable taking ownership of a feature or system from requirements through development, testing,
            deployment support, and ongoing improvement.
          </p>
        </div>
      </div>
    </section>

    <section class="section" id="opportunities">
      <div class="container">
        <h2 class="section-title">Open to Opportunities</h2>
        <p class="section-subtitle">
          Currently open to roles where software engineering and business-systems experience can create value—without
          claiming expertise outside that foundation.
        </p>
        <div class="row">
          {careerInterests.map((group) => (
            <div class="col-md-6 col-lg-4 mb-4">
              <div class="skill-box h-100">
                <h3>{group.title}</h3>
                <div class="chip-row">
                  {group.items.map((item) => (
                    <span class="chip">{item}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt" id="education">
      <div class="container">
        <h2 class="section-title">Education</h2>
        <p class="section-subtitle">Academic foundation and professional training.</p>
        <div class="row">
          {education.map((e) => (
            <div class="col-lg-6 mb-4">
              <div class="hero-card">
                <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;">
                  <div>
                    <h3 class="item-title">{e.degree}</h3>
                    <div class="small-muted" style="margin-top:4px;">{e.org}</div>
                  </div>
                  <div class="chip" style="height:fit-content;">{e.time}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="container">
        <h2 class="section-title">Let's Work Together</h2>
        <p class="section-subtitle">
          Exploring new opportunities in software engineering, full-stack/backend development, business applications,
          automation, data and reporting, and ICT solutions.
        </p>
        <div class="row g-4">
          <div class="col-lg-7">
            <div class="hero-card">
              <h3 class="item-title" style="margin-bottom:10px;">Looking for someone technical and practical?</h3>
              <p class="hero-lead" style="margin:0;">
                If you need someone who understands both the technical side and the business side of software, I'd be
                happy to connect.
              </p>
            </div>
          </div>
          <div class="col-lg-5">
            <div class="hero-card">
              <h3 class="item-title" style="margin-bottom:10px;">Contact</h3>
              <p class="hero-lead" style="margin:0 0 14px;">
                {profile.location}
              </p>
              <div class="card-actions">
                <a class="link-btn" href={`mailto:${profile.email}`}>
                  <i class="fa fa-envelope" aria-hidden="true"></i> {profile.email}
                </a>
                <a class="link-btn" href={profile.links.linkedin} target="_blank" rel="noreferrer">
                  <i class="fa fa-linkedin" aria-hidden="true"></i> LinkedIn
                </a>
                <a class="link-btn" href={profile.links.github} target="_blank" rel="noreferrer">
                  <i class="fa fa-github" aria-hidden="true"></i> GitHub
                </a>
                <a class="link-btn" href={profile.resumeUrl} target="_blank" rel="noreferrer">
                  <i class="fa fa-download" aria-hidden="true"></i> Download CV
                </a>
              </div>
              <div class="small-muted" style="margin-top:12px;">{profile.phone}</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-start gap-2">
      <div>
        <div style="font-weight:900;">{profile.name}</div>
        <div class="small-muted">
          Software Engineer · Business Applications · Automation · Data & ICT · {profile.location}
        </div>
      </div>
      <div class="small-muted">© {year} · sshanto13.github.io</div>
    </div>
  </footer>
</BaseLayout>
