---
type Props = {
  title: string;
  description?: string;
  canonicalPath?: string;
  structuredData?: Record<string, unknown>;
};

const { title, description, canonicalPath, structuredData } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const canonicalUrl = new URL(canonicalPath ?? '/', Astro.site ?? 'https://sshanto13.github.io').toString();
const siteUrl = Astro.site ?? 'https://sshanto13.github.io';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content={description ?? ''} />
    <meta name="robots" content="index,follow" />
    <meta name="author" content="Sumon Ray" />
    <link rel="shortcut icon" href={`${baseUrl}img/favicon.ico`} type="image/x-icon" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#0b1020" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sumon Ray" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? ''} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}${baseUrl}img/ss-linkedin.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description ?? ''} />
    <meta name="twitter:image" content={`${siteUrl}${baseUrl}img/ss-linkedin.png`} />

    {structuredData ? (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    ) : null}

    <link href={`${baseUrl}vendor/bootstrap/css/bootstrap.min.css`} rel="stylesheet" />
    <link href={`${baseUrl}vendor/font-awesome/css/font-awesome.min.css`} rel="stylesheet" type="text/css" />
    <link href={`${baseUrl}css/site.css`} rel="stylesheet" />
  </head>

  <body id="page-top">
    <slot />

    <script src={`${baseUrl}vendor/jquery/jquery.min.js`}></script>
    <script src={`${baseUrl}vendor/bootstrap/js/bootstrap.bundle.min.js`}></script>
    <script src={`${baseUrl}js/site.js`}></script>
  </body>
</html>

