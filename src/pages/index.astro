---
import BaseLayout from '../layouts/BaseLayout.astro';

const year = new Date().getFullYear();

const profile = {
  name: 'Sumon Ray',
  title: 'Software Engineer',
  tagline: 'PHP • Laravel • REST APIs • MySQL • 7+ Years Experience',
  company: 'Destinique LLC',
  location: 'Dhaka, Bangladesh',
  photoSrc: 'img/ss-linkedin.png',
  email: 'sumancsediu@gmail.com',
  phone: '+88 01952 499680',
  resumeUrl: 'files/Sumon_Ray_Software_Engineer_updated_2026.pdf',
  links: {
    github: 'https://github.com/sshanto13',
    linkedin: 'https://linkedin.com/in/sshanto13/',
    facebook: 'https://fb.com/sshanto21/',
  },
};

type Project = {
  title: string;
  description: string;
  highlights?: string[];
  role?: string;
  impact?: string;
  image: string;
  stack: string[];
  liveUrl?: string;
  repoUrl?: string;
};

const featuredProjects: Project[] = [
  {
    title: 'Destinique — Luxury Travel & Vacation Platform',
    description:
      'Customer-facing travel platform with booking, business operations, analytics, and marketing integrations.',
    role: 'Software Engineer',
    impact: 'Delivered frontend and backend features supporting travel products and business operations.',
    highlights: [
      'Developed travel product, booking, and business operation features',
      'Contributed to customer-facing website using Angular with integrated backend services',
      'Built analytics and marketing integrations for data-driven decisions',
    ],
    image: 'img/screenshots/destinique.png',
    stack: ['Angular', 'PHP REST API', 'MySQL', 'JavaScript', 'Bootstrap', 'Cloudflare'],
    liveUrl: 'https://destinique.com/',
  },
  {
    title: 'Destinique Dashboard — Internal Business Platform',
    description:
      'Internal tools for booking, product, promotion, reporting, and business operations.',
    role: 'Software Engineer',
    impact: 'Built operational dashboards and workflow automation for the luxury travel team.',
    highlights: [
      'Developed Visitor Tracking, Advertisement Generation, and Promotion Management systems',
      'Built Property Management and Booking Management tools',
      'Designed REST APIs, dashboards, and business workflow automation',
    ],
    image: 'img/screenshots/destinique_dashboard_ad_generation.png',
    stack: ['PHP', 'MySQL', 'JavaScript', 'Bootstrap', 'Cloudflare'],
    liveUrl: 'https://quote.destinique.com/destin/dashboard/',
  },
  {
    title: 'PaiMart — Wholesale E‑commerce',
    description:
      'Wholesale e-commerce platform with product, order, customer, and business operations management.',
    role: 'Assistant Manager (Engineering)',
    impact: 'Delivered e-commerce, POS, ERP, and internal business tools for Bangladesh and Dubai markets.',
    highlights: [
      'Developed and maintained e-commerce platforms, POS systems, and ERP solutions',
      'Designed database structures, business workflows, and API integrations',
      'Led backend and full-stack development using PHP, Laravel, and REST APIs',
    ],
    image: 'img/screenshots/paimart.png',
    stack: ['Laravel', 'MySQL', 'JavaScript', 'Bootstrap', 'Vultr'],
    liveUrl: 'https://paimart.painest.com/',
  },
  {
    title: 'JS ERP — Sales, Billing & Inventory System',
    description: 'ERP system for sales, invoicing, billing, inventory, and employee management.',
    role: 'Backend engineer',
    impact: 'Delivered core business workflows for internal operations and reporting.',
    highlights: [
      'Built ERP features for sales, invoicing, billing, inventory, and employee management',
      'Designed data models and optimized queries for reporting workflows',
    ],
    image: 'img/portfolio/js-erp.png',
    stack: ['Laravel', 'MySQL', 'JavaScript', 'Bootstrap', 'Vultr'],
    liveUrl: 'https://js-erp.paitechno.com',
  },
  {
    title: 'E-commerce Operation — Back Office Management',
    description: 'Back-office system for order, product, inventory, and e-commerce operations management.',
    role: 'Backend engineer',
    impact: 'Streamlined internal operations for a growing e-commerce business.',
    highlights: [
      'Developed back-office solutions for order and product management',
      'Built inventory and e-commerce operations workflows',
    ],
    image: 'img/portfolio/paikaree.png',
    stack: ['Laravel', 'MySQL', 'JavaScript', 'Bootstrap', 'Vultr'],
    liveUrl: 'https://operation.paikaree.com',
  },
  {
    title: 'TERBB — Government Project',
    description: 'CMS-based government web platform with backend and database management.',
    role: 'Backend engineer',
    impact: 'Built a secure, high-reliability workflow for government-scale operations.',
    highlights: [
      'Developed CMS-based government web platform',
      'Managed backend systems and database workflows for production use',
    ],
    image: 'img/portfolio/terbb.png',
    stack: ['Laravel', 'MySQL', 'Bootstrap'],
    liveUrl: 'http://apps.ngte-welfaretrust.gov.bd',
  },
];

const skillGroups: { title: string; skills: string[] }[] = [
  {
    title: 'Backend & Programming',
    skills: ['PHP', 'Laravel', 'REST APIs', 'JavaScript', 'TypeScript'],
  },
  {
    title: 'Frontend',
    skills: ['Vue.js', 'jQuery', 'AJAX', 'HTML5', 'CSS3', 'Tailwind CSS', 'Bootstrap', 'Angular', 'React'],
  },
  {
    title: 'Database',
    skills: ['MySQL', 'Redis'],
  },
  {
    title: 'Cloud & Infrastructure',
    skills: ['AWS (EC2, RDS, SES)', 'DigitalOcean', 'Vultr', 'Cloudflare', 'Vercel'],
  },
  {
    title: 'Others',
    skills: ['WordPress', 'WooCommerce', 'Git', 'CI/CD'],
  },
];

type Experience = {
  company: string;
  title: string;
  location: string;
  start: string;
  end: string;
  bullets: string[];
};

const experience: Experience[] = [
  {
    company: 'Destinique LLC',
    title: 'Software Engineer',
    location: 'Remote, USA',
    start: 'Feb 2025',
    end: 'Present',
    bullets: [
      'Build and maintain internal software products supporting luxury travel and property operations.',
      'Developed internal tools including Visitor Tracking, Advertisement Generation, Promotion Management, Property Management, and Booking Management systems.',
      'Built REST APIs, database-driven applications, dashboards, and business workflow automation.',
      'Contributed to the customer-facing website using Angular and integrated backend services.',
    ],
  },
  {
    company: 'PaiMart by PaiNest',
    title: 'Assistant Manager (Engineering)',
    location: 'Dhaka, Bangladesh',
    start: 'Jan 2021',
    end: 'Jan 2025',
    bullets: [
      'Developed and maintained e-commerce platforms, POS systems, ERP solutions, APIs, and internal business tools.',
      'Led backend and full-stack development using PHP, Laravel, MySQL, JavaScript, and REST APIs.',
      'Designed database structures, business workflows, and integrations for commerce and operational processes.',
      'Collaborated with engineering and business teams to deliver scalable software solutions.',
    ],
  },
  {
    company: 'ADN Telecom Limited',
    title: 'Assistant Manager (Engineering)',
    location: 'Gulshan, Dhaka, Bangladesh',
    start: 'Oct 2019',
    end: 'Jan 2021',
    bullets: [
      'Developed web applications, e-commerce platforms, backend services, and REST APIs for enterprise clients.',
      'Designed and implemented backend systems using PHP, Laravel, and MySQL.',
      'Collaborated with cross-functional teams to analyze requirements and deliver production-ready applications.',
    ],
  },
  {
    company: 'Nybbles Systems Limited (NYBSYS)',
    title: 'Software Engineer',
    location: 'Mirpur, Dhaka, Bangladesh',
    start: 'Dec 2017',
    end: 'Oct 2019',
    bullets: [
      'Developed frontend applications, web interfaces, and API integrations for large-scale software solutions.',
      'Collaborated with distributed teams on web, mobile, IoT, LTE, and telecommunications-related projects.',
      'Translated UI/UX designs and technical requirements into responsive, production-ready web applications.',
    ],
  },
];

const education = [
  {
    degree: 'B.Sc. in Computer Science & Engineering',
    org: 'Dhaka International University',
    time: '2010 – 2015',
  },
  {
    degree: 'Web Applications Development with PHP',
    org: 'BITM, BASIS',
    time: '2015',
  },
];
---

<BaseLayout
  title={`${profile.name} — ${profile.title}`}
  description="Software engineer portfolio: Laravel/PHP, REST APIs, e-commerce, ERP systems, and production-ready web applications."
  canonicalPath="/"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.title,
    url: Astro.site ?? 'https://sshanto13.github.io',
    image: new URL(profile.photoSrc, Astro.site ?? 'https://sshanto13.github.io').toString(),
    email: `mailto:${profile.email}`,
    telephone: profile.phone,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Dhaka',
      addressCountry: 'BD',
    },
    sameAs: [profile.links.github, profile.links.linkedin, profile.links.facebook],
  }}
>
  <header class="site-nav">
    <nav class="container nav-inner navbar navbar-expand-lg navbar-light">
      <a class="brand" href="#top">
        <span class="brand-badge">SR</span>
        <span>{profile.name}</span>
      </a>

      <button
        class="navbar-toggler"
        type="button"
        data-toggle="collapse"
        data-target="#navLinks"
        aria-controls="navLinks"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navLinks">
        <ul class="navbar-nav ml-auto">
          <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
          <li class="nav-item"><a class="nav-link" href="#skills">Expertise</a></li>
          <li class="nav-item"><a class="nav-link" href="#experience">Experience</a></li>
          <li class="nav-item"><a class="nav-link" href="#projects">Projects</a></li>
          <li class="nav-item"><a class="nav-link" href="#education">Education</a></li>
          <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
          <li class="nav-item">
            <a class="nav-link" href={profile.resumeUrl} target="_blank" rel="noreferrer">Resume</a>
          </li>
        </ul>
      </div>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <div class="container">
        <div class="row g-4 align-items-center">
          <div class="col-lg-5 order-1 order-lg-2">
            <div class="profile">
              <div class="profile-frame">
                <img src={profile.photoSrc} alt={`${profile.name} profile photo`} loading="eager" />
              </div>
              <div class="mt-3 social">
                <a class="link-btn" href={profile.links.linkedin} target="_blank" rel="noreferrer">
                  <i class="fa fa-linkedin" aria-hidden="true"></i> LinkedIn
                </a>
                <a class="link-btn" href={profile.links.github} target="_blank" rel="noreferrer">
                  <i class="fa fa-github" aria-hidden="true"></i> GitHub
                </a>
              </div>
            </div>
          </div>

          <div class="col-lg-7 order-2 order-lg-1">
            <div class="hero-card">
              <span class="hero-kicker">
                <i class="fa fa-code" aria-hidden="true"></i>
                Software Engineer (PHP/Laravel & Full-Stack)
              </span>

              <h1 class="hero-title">
                {profile.name}
              </h1>
              <p class="hero-lead" style="margin-top:-6px;">
                Software Engineer with <strong>7+ years</strong> of experience designing, developing, and maintaining web applications,
                business systems, and digital products across <strong>e-commerce</strong>, <strong>telecommunications</strong>,
                <strong>enterprise services</strong>, and <strong>luxury travel</strong>. Strong background in
                <strong>PHP, Laravel, MySQL, JavaScript</strong>, and <strong>REST APIs</strong>, with experience building
                ERP/POS systems, e-commerce platforms, internal business tools, and data-driven dashboards.
              </p>
              <p class="hero-lead">
                {profile.location} • Remote ready • Currently at <strong>{profile.company}</strong>
              </p>

              <div class="hero-actions">
                <a class="btn-primary-neo" href="#projects">
                  <i class="fa fa-briefcase" aria-hidden="true"></i> View projects
                </a>
                <a class="btn-ghost" href={profile.resumeUrl} target="_blank" rel="noreferrer">
                  <i class="fa fa-download" aria-hidden="true"></i> Download CV
                </a>
                <a class="btn-ghost" href={profile.links.github} target="_blank" rel="noreferrer">
                  <i class="fa fa-github" aria-hidden="true"></i> GitHub
                </a>
              </div>

              <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:14px;">
                <span class="chip"><i class="fa fa-envelope" aria-hidden="true"></i>&nbsp;{profile.email}</span>
                <span class="chip"><i class="fa fa-phone" aria-hidden="true"></i>&nbsp;{profile.phone}</span>
              </div>

              <div class="stat-row" aria-label="quick stats">
                <div class="stat">
                  <strong>7+ years</strong>
                  <span>Professional experience</span>
                </div>
                <div class="stat">
                  <strong>Laravel + MySQL</strong>
                  <span>Backend & APIs</span>
                </div>
                <div class="stat">
                  <strong>Responsive UI</strong>
                  <span>Frontend delivery</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="about">
      <div class="container">
        <h2 class="section-title">Professional summary</h2>
        <p class="section-subtitle">
          Software Engineer with 7+ years of experience designing, developing, and maintaining web applications, business systems,
          and digital products across e-commerce, telecommunications, enterprise services, and luxury travel.
        </p>
        <p class="section-subtitle" style="margin-top:-10px;">
          Experienced in building full-stack applications, REST APIs, ERP and POS systems, e-commerce platforms, internal business tools,
          property and booking systems, and data-driven dashboards—with strong skills in PHP, Laravel, MySQL, JavaScript, and cloud technologies.
        </p>

        <div class="row">
          <div class="col-md-6 col-lg-4 mb-4">
            <div class="skill-box">
              <h3>Backend architecture</h3>
              <div class="small-muted">High-throughput REST APIs, Laravel optimizations, scalable workflows</div>
            </div>
          </div>
          <div class="col-md-6 col-lg-4 mb-4">
            <div class="skill-box">
              <h3>Performance engineering</h3>
              <div class="small-muted">MySQL tuning, Redis caching, background processing</div>
            </div>
          </div>
          <div class="col-md-6 col-lg-4 mb-4">
            <div class="skill-box">
              <h3>Infrastructure basics</h3>
              <div class="small-muted">Cloudflare, DigitalOcean/Vultr, DNS/email, CI/CD</div>
            </div>
          </div>
          <div class="col-md-6 col-lg-4 mb-4">
            <div class="skill-box">
              <h3>AI tools & productivity</h3>
              <div class="small-muted">Cursor AI, Anthropic Claude, ChatGPT, Gemini</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="skills">
      <div class="container">
        <h2 class="section-title">Core expertise</h2>
        <p class="section-subtitle">
          I focus on the “heavy lifting” parts of web applications—scalable backend systems, performance work, and production reliability.
        </p>
        <div class="skill-grid">
          {skillGroups.map((g) => (
            <div class="skill-box">
              <h3>{g.title}</h3>
              <div class="chip-row">
                {g.skills.map((s) => (
                  <span class="chip">{s}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="experience">
      <div class="container">
        <h2 class="section-title">Work experience</h2>
        <p class="section-subtitle">
          Recent roles and responsibilities based on my latest resume.
        </p>

        <div class="row">
          {experience.map((e) => (
            <div class="col-12 mb-4">
              <article class="hero-card">
                <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;">
                  <div>
                    <h3 style="margin:0;font-weight:900;">{e.title}</h3>
                    <div class="small-muted" style="margin-top:4px;">{e.company} • {e.location}</div>
                  </div>
                  <div class="chip" style="height:fit-content;">{e.start} → {e.end}</div>
                </div>
                <ul class="list-muted">
                  {e.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </article>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="projects">
      <div class="container">
        <h2 class="section-title">Featured projects</h2>
        <p class="section-subtitle">
          A few projects that represent my day-to-day work: backend APIs, business workflows, and production-ready UI.
        </p>

        <div class="row g-4">
          {featuredProjects.map((p) => (
            <div class="col-md-6 col-lg-4">
              <article class="card-neo">
                <div class="card-media">
                  <img src={p.image} alt={`${p.title} screenshot`} loading="lazy" />
                </div>
                <div class="card-body-neo">
                  <h3 class="card-title-neo">{p.title}</h3>
                  <p class="card-text-neo">{p.description}</p>
                  {p.role ? <div class="small-muted" style="margin-bottom:8px;">Role: <strong>{p.role}</strong></div> : null}
                  {p.impact ? <div class="small-muted" style="margin-bottom:10px;">Impact: {p.impact}</div> : null}
                  {p.highlights?.length ? (
                    <ul class="list-muted" style="margin-top:0;margin-bottom:12px;">
                      {p.highlights.map((h) => (
                        <li>{h}</li>
                      ))}
                    </ul>
                  ) : null}
                  <div class="chip-row" aria-label="tech stack">
                    {p.stack.map((s) => (
                      <span class="chip">{s}</span>
                    ))}
                  </div>
                  <div class="card-actions">
                    {p.liveUrl ? (
                      <a class="link-btn" href={p.liveUrl} target="_blank" rel="noreferrer">
                        <i class="fa fa-external-link" aria-hidden="true"></i> Live
                      </a>
                    ) : null}
                    {p.repoUrl ? (
                      <a class="link-btn" href={p.repoUrl} target="_blank" rel="noreferrer">
                        <i class="fa fa-github" aria-hidden="true"></i> Code
                      </a>
                    ) : null}
                  </div>
                </div>
              </article>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt" id="education">
      <div class="container">
        <h2 class="section-title">Education</h2>
        <p class="section-subtitle">Academic foundation and professional training.</p>
        <div class="row">
          {education.map((e) => (
            <div class="col-lg-6 mb-4">
              <div class="hero-card">
                <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;">
                  <div>
                    <h3 style="margin:0;font-weight:900;">{e.degree}</h3>
                    <div class="small-muted" style="margin-top:4px;">{e.org}</div>
                  </div>
                  <div class="chip" style="height:fit-content;">{e.time}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="container">
        <h2 class="section-title">Get in touch</h2>
        <p class="section-subtitle">
          Open to collaboration, product work, and backend/API engineering roles.
        </p>
        <div class="row g-4">
          <div class="col-lg-7">
            <div class="hero-card">
              <h3 style="margin:0 0 10px;font-weight:900;">My approach</h3>
              <p class="hero-lead" style="margin:0;">
                I’m comfortable owning features end-to-end: requirements → implementation → testing → deployment support.
                I care about maintainability (clear naming, reusable components, small PRs) and performance (fast pages, efficient queries).
              </p>
            </div>
          </div>
          <div class="col-lg-5">
            <div class="hero-card">
              <h3 style="margin:0 0 10px;font-weight:900;">Let’s connect</h3>
              <p class="hero-lead" style="margin:0 0 14px;">
                Email or message me—happy to chat.
              </p>
              <div class="card-actions">
                <a class="link-btn" href={`mailto:${profile.email}`}>
                  <i class="fa fa-envelope" aria-hidden="true"></i> Email
                </a>
                <a class="link-btn" href={profile.links.linkedin} target="_blank" rel="noreferrer">
                  <i class="fa fa-linkedin" aria-hidden="true"></i> Message on LinkedIn
                </a>
                <a class="link-btn" href={profile.links.github} target="_blank" rel="noreferrer">
                  <i class="fa fa-github" aria-hidden="true"></i> View GitHub
                </a>
              </div>
              <div class="small-muted" style="margin-top:12px;">
                {profile.email} • {profile.phone}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-start gap-2">
      <div>
        <div style="font-weight:900;">{profile.name}</div>
        <div class="small-muted">{profile.title} • {profile.location}</div>
      </div>
      <div class="small-muted">© {year} • Built with Astro</div>
    </div>
  </footer>
</BaseLayout>

