---
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredProjects } from '../data/projects';
import { cv } from '../data/cv';
import { moreProjects, projectSections } from '../data/moreProjects';
import MiniProjectCard from '../components/MiniProjectCard.astro';

const year = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;

const profile = {
  name: 'Sumon Ray',
  title: 'IT & Digitalization · 10+ Years',
  location: 'Dhaka, Bangladesh',
  photoSrc: 'img/ss-linkedin.png',
  email: 'sumancsediu@gmail.com',
  phone: '+880 1952 499680',
  resumeUrl: 'files/Sumon_Ray_CV_Lead_IT_Digitalisation_2026.pdf',
  links: {
    github: 'https://github.com/sshanto13',
    linkedin: 'https://linkedin.com/in/sshanto13/',
    facebook: 'https://fb.com/sshanto21/',
  },
};

// Text below comes from the CV (src/data/cv.ts, generated from the final CV document).
const summaryParts = cv.summary.split(/(?<=\.)\s+/);
const heroLead = summaryParts[0];
const heroFollow = summaryParts.slice(1).join(' ');
const leadership = cv.techGroups[cv.techGroups.length - 1].lines;

const usefulFor = [
  'Business applications and ERP — custom ERP, POS, e-commerce, and supply chain systems.',
  'Business process automation, operational reporting, and dashboards tied to real business needs.',
  'Server and infrastructure support — hosting, DNS, email, backups, access control, and cost management.',
  'Production security basics — firewall configuration, Cloudflare-based Layer 7 DDoS mitigation, and automated backups.',
  'Coordinating developers, QA, business stakeholders, and technology vendors to get delivery done.',
];

const whatIDo = cv.highlights;

const beyondCoding = [
  {
    title: 'Business understanding',
    text: 'I try to learn how the work actually gets done before writing code — otherwise you build the wrong thing.',
  },
  {
    title: 'Automation',
    text: 'If people are repeating the same clicks or spreadsheet steps, I look for a small tool, report, or workflow that cuts that down.',
  },
  {
    title: 'Data',
    text: 'A lot of “business questions” are really SQL and reporting problems. I’m comfortable digging into that.',
  },
  {
    title: 'Problem solving',
    text: 'Production bugs, broken integrations, slow queries — I’ve spent a lot of time chasing those down.',
  },
  {
    title: 'Working with people',
    text: 'Used to talking with developers, QA, managers, and ops folks (local and remote) to get something shipped.',
  },
  {
    title: 'Ownership',
    text: 'I take features from “we need this” through build, ship, and follow-up — not just handing off code and walking away.',
  },
];

const skillGroups = cv.techGroups.map((g) => ({
  label: g.title.replace(/^\d+\.\s*/, ''),
  lines: g.lines,
}));

const stats = [
  { value: '10+', label: 'Years of experience' },
  { value: 'Local & Global', label: 'Teams worked with', text: true },
  { value: '50+', label: 'Projects delivered' },
];

const roleMeta = (r: { period?: string; location?: string }) => [r.period, r.location].filter(Boolean).join(' · ');

const experienceGroups = [
  { label: 'Professional experience', items: cv.experience },
  { label: 'Global project engagements', items: cv.consultancy },
  { label: 'Government initiative', items: cv.government },
];

const { education, training } = cv;

const popupSections = projectSections
  .map((sec) => ({
    title: sec.title,
    groups: sec.groups
      .map((g) => ({ name: g.name, items: moreProjects.filter((p) => p.group === g.key) }))
      .filter((g) => g.items.length),
  }))
  .filter((sec) => sec.groups.length);
const otherProjects = moreProjects.filter((p) => !p.group);

---

<BaseLayout
  title={`${profile.name} — IT & Digitalization`}
  description="Sumon Ray — IT & Digitalization professional in Dhaka with over a decade of experience in ERP, e-commerce, system integration, IT infrastructure, security, and automation. Open to new roles."
  canonicalPath="/"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profile.name,
    jobTitle: 'IT & Digitalization Professional',
    url: Astro.site ?? 'https://sshanto13.github.io',
    image: new URL(profile.photoSrc, Astro.site ?? 'https://sshanto13.github.io').toString(),
    email: `mailto:${profile.email}`,
    telephone: profile.phone,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Dhaka',
      addressCountry: 'BD',
    },
    sameAs: [profile.links.github, profile.links.linkedin, profile.links.facebook],
  }}
>
  <header class="site-nav" id="siteNav">
    <nav class="fk-nav container" aria-label="Primary">
      <a class="fk-nav-brand" href="#top" aria-label="Sumon Ray home">
        <span class="fk-nav-logo">Sumon Ray</span>
      </a>

      <div class="fk-nav-links" id="navLinks">
        <a class="fk-nav-link" href="#about">About</a>
        <a class="fk-nav-link" href="#experience">Experience</a>
        <a class="fk-nav-link" href="#projects">Projects</a>
        <a class="fk-nav-link" href="#skills">Skills</a>
      </div>

      <a class="fk-nav-contact" href="#contact">Contact</a>

      <button class="fk-theme-toggle" type="button" aria-label="Switch to dark mode" title="Toggle theme">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5z"></path>
        </svg>
      </button>

      <button class="fk-nav-toggle" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="navLinks">
        <span></span><span></span><span></span>
      </button>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <div class="container">
        <div class="row g-4 align-items-center">
          <div class="col-lg-5 order-1 order-lg-2">
            <div class="profile reveal is-in">
              <div class="profile-frame">
                <img src={profile.photoSrc} alt={`${profile.name} profile photo`} loading="eager" />
              </div>
              <div class="mt-3 social">
                <a class="link-btn" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
                  <i class="fa fa-linkedin" aria-hidden="true"></i> LinkedIn
                </a>
                <a class="link-btn" href={profile.links.github} target="_blank" rel="noopener noreferrer">
                  <i class="fa fa-github" aria-hidden="true"></i> GitHub
                </a>
              </div>
            </div>
          </div>

          <div class="col-lg-7 order-2 order-lg-1">
            <div class="hero-card reveal is-in">
              <span class="hero-kicker">Dhaka · open to the next role</span>

              <p class="hero-name">{profile.name}</p>
              <p class="hero-role">{profile.title}</p>
              <h1 class="hero-title">
                Practical technology for <em>real business operations</em>.
              </h1>
              <p class="hero-lead">{heroLead}</p>
              <p class="hero-lead hero-lead-follow">{heroFollow}</p>

              <div class="hero-actions">
                <a class="btn-primary-neo" href="#contact">Get in touch</a>
                <a class="btn-ghost" href={profile.resumeUrl} target="_blank" rel="noopener noreferrer">View Resume</a>
                <a class="btn-ghost" href="#projects">See projects</a>
              </div>

              <div class="stat-row stat-row-impact" aria-label="quick stats">
                {stats.map((s) => (
                  <div class={s.text ? 'stat stat-lg stat-text' : 'stat stat-lg'}>
                    <strong>{s.value}</strong>
                    <span>{s.label}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section about-section" id="about" aria-labelledby="about-heading">
      <div class="container about-shell">
        <div class="about-card reveal">
          <div class="about-card-top">
            <div>
              <p class="about-card-kicker">About</p>
              <h2 class="about-card-title" id="about-heading">About Me</h2>
            </div>
            <div class="about-card-meta">
              <span>{profile.location}</span>
              <span class="about-card-dot" aria-hidden="true"></span>
              <span>Open to new opportunities</span>
            </div>
          </div>

          <div class="about-card-body">
            <p class="about-card-lead">{heroLead}</p>

            <div class="about-card-copy">
              <p>{summaryParts[1]}</p>
              <p>{summaryParts[2]}</p>
              {leadership.map((l) => (
                <p>{l.text}</p>
              ))}
              <p>
                What I enjoy most is working where technology and business come together—understanding the problem,
                finding a practical solution, building it, and seeing it work in the real world.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="skills">
      <div class="container">
        <header class="section-head reveal">
          <p class="section-kicker">Skills</p>
          <h2 class="section-lead">What I bring to your team</h2>
          <p class="section-desc">
            Technical experience across <strong>enterprise applications &amp; ERP, software engineering &amp; automation,
            data &amp; BI, IT infrastructure &amp; cybersecurity, and delivery leadership</strong> — over a decade of
            hands-on work from development through production support.
          </p>
        </header>

        <div class="skill-rows reveal">
          {skillGroups.map((g) => (
            <div class="skill-row">
              <div class="skill-row-label">{g.label}</div>
              <div class="skill-row-values">
                <ul class="skill-lines">
                  {g.lines.map((l) => (
                    <li>
                      <strong>{l.label}:</strong> {l.text}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section-experience" id="experience">
      <div class="container py-5">
        <div class="row mb-5">
          <div class="col text-center reveal">
            <p class="section-kicker">Experience</p>
            <h2 class="exp-section-title">Where I’ve shipped</h2>
            <p class="exp-section-sub">Employment, global project engagements, and a government training initiative — Bangladesh, the US, and Europe.</p>
          </div>
        </div>

        <div class="timeline">
          {experienceGroups.map((group) => (
            <>
              <h3 class="timeline-group-title reveal">{group.label}</h3>
              {group.items.map((e) => (
                <div class="timeline-item mb-5 reveal">
                  <span class="timeline-dot"></span>
                  <article class="card exp-card border-0 shadow-sm p-4 ml-3">
                    <div class="d-flex align-items-center mb-3 exp-card-head">
                      {e.logo ? (
                        <img src={e.logo} alt="" width="48" height="48" class="rounded exp-logo" loading="lazy" />
                      ) : (
                        <div class="exp-logo-fallback rounded" aria-hidden="true">
                          {e.company.charAt(0)}
                        </div>
                      )}
                      <div>
                        <h3 class="exp-role mb-0">{e.title}</h3>
                        <span class="exp-company">
                          {e.companyUrl ? (
                            <a href={e.companyUrl} class="text-decoration-none" target="_blank" rel="noopener noreferrer">
                              {e.company}
                            </a>
                          ) : (
                            e.company
                          )}
                        </span>
                      </div>
                    </div>
                    <div class="text-muted small mb-3">
                      {roleMeta(e)}
                      {e.engagement ? <span class="badge exp-badge exp-engagement">{e.engagement}</span> : null}
                    </div>
                    {e.intro ? <p class="mb-3 exp-summary">{e.intro}</p> : null}
                    <h4 class="exp-achievements-label">What I worked on</h4>
                    <ul class="mb-3 exp-bullets">
                      {e.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                    {e.keyProjects ? (
                      <p class="exp-key-projects">
                        <strong>Key projects:</strong> {e.keyProjects}
                      </p>
                    ) : null}
                    {e.stack?.length ? (
                      <div class="d-flex flex-wrap exp-badges">
                        {e.stack.map((s) => (
                          <span class="badge exp-badge">{s}</span>
                        ))}
                      </div>
                    ) : null}
                  </article>
                </div>
              ))}
            </>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt" id="projects">
      <div class="container">
        <header class="project-section-head reveal">
          <p class="section-kicker">Projects</p>
          <h2 class="section-lead">Selected work</h2>
          <p class="section-desc">
            A selection of projects that showcase practical software for business operations, automation, and delivery.
          </p>
          <button type="button" class="btn-ghost project-more-btn project-more-top" data-open-projects aria-haspopup="dialog" aria-controls="moreProjects">
            Project see more <span class="project-more-count">{moreProjects.length}</span>
          </button>
        </header>

        <div class="project-showcase">
          {featuredProjects.map((p) => {
            const visibleStack = p.stack.slice(0, 5);
            const moreCount = Math.max(0, p.stack.length - visibleStack.length);
            const detailUrl = `${baseUrl}projects/${p.slug}/`;
            return (
              <article class="project-card reveal">
                <div class="project-card-media">
                  <a href={detailUrl} class="project-card-image-link">
                    <img src={p.image} alt={`${p.title} screenshot`} loading="lazy" />
                  </a>
                </div>
                <div class="project-card-body">
                  <h3 class="project-card-title">
                    <a href={detailUrl} class="project-card-title-link">{p.title}</a>
                  </h3>
                  <p class="project-card-company">{p.company}</p>
                  <p class="project-card-desc">{p.description}</p>
                  <div class="project-card-tags" aria-label="tech stack">
                    {visibleStack.map((s) => (
                      <span class="project-tag">{s}</span>
                    ))}
                    {moreCount > 0 ? <span class="project-tag project-tag-more">+{moreCount} more</span> : null}
                  </div>
                  <div class="project-card-actions">
                    <a class="link-btn" href={detailUrl}>
                      Details
                    </a>
                    {p.liveUrl ? (
                      <a class="link-btn" href={p.liveUrl} target="_blank" rel="noopener noreferrer">
                        <i class="fa fa-external-link" aria-hidden="true"></i> Live <span class="sr-only">(opens in a new tab)</span>
                      </a>
                    ) : null}
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <div class="project-more">
          <button type="button" class="btn-ghost project-more-btn" data-open-projects aria-haspopup="dialog" aria-controls="moreProjects">
            See more projects <span class="project-more-count">{moreProjects.length}</span>
          </button>
        </div>
      </div>
    </section>

    <dialog class="projects-dialog" id="moreProjects" aria-labelledby="moreProjectsTitle">
      <div class="projects-dialog-inner">
        <div class="projects-dialog-head">
          <div>
            <p class="section-kicker">More work</p>
            <h2 class="projects-dialog-title" id="moreProjectsTitle">More projects</h2>
          </div>
          <button type="button" class="projects-dialog-close" data-close-projects aria-label="Close projects">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="projects-dialog-body">
          {popupSections.map((sec) => (
            <section class="popup-section">
              <h3 class="popup-section-title">{sec.title}</h3>
              {sec.groups.map((g) => (
                <div class="popup-group">
                  {g.name ? <h4 class="popup-group-title">{g.name}</h4> : null}
                  <div class="project-showcase">
                    {g.items.map((p) => (
                      <MiniProjectCard p={p} />
                    ))}
                  </div>
                </div>
              ))}
            </section>
          ))}
          {otherProjects.length ? (
            <section class="popup-section">
              <h3 class="popup-section-title">Other projects</h3>
              <div class="project-showcase">
                {otherProjects.map((p) => (
                  <MiniProjectCard p={p} />
                ))}
              </div>
            </section>
          ) : null}
        </div>
      </div>
    </dialog>

    <dialog class="lightbox" id="lightbox" aria-label="Project screenshot viewer">
      <button type="button" class="lightbox-close" data-lb-close aria-label="Close viewer">&times;</button>
      <button type="button" class="lightbox-nav lightbox-prev" data-lb-prev aria-label="Previous project">&#8249;</button>
      <figure class="lightbox-figure">
        <img class="lightbox-img" id="lightboxImg" alt="" />
        <figcaption class="lightbox-caption">
          <div>
            <strong id="lightboxTitle"></strong>
            <span id="lightboxLabel"></span>
          </div>
          <div class="lightbox-meta">
            <a id="lightboxLive" class="link-btn" href="#" target="_blank" rel="noopener noreferrer" hidden>
              <i class="fa fa-external-link" aria-hidden="true"></i> Live
            </a>
            <span id="lightboxCount" class="lightbox-count"></span>
          </div>
        </figcaption>
      </figure>
      <button type="button" class="lightbox-nav lightbox-next" data-lb-next aria-label="Next project">&#8250;</button>
    </dialog>

    <section class="section" id="what-i-do">
      <div class="container">
        <header class="section-head reveal">
          <p class="section-kicker">Capabilities</p>
          <h2 class="section-lead">What I Do</h2>
          <p class="section-desc">The kinds of work I usually end up doing.</p>
        </header>
        <div class="row">
          {whatIDo.map((item) => (
            <div class="col-md-6 col-lg-3 mb-4 reveal">
              <div class="service-card h-100">
                <h3 class="service-title">{item.title}</h3>
                <p class="service-text">{item.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt" id="beyond-coding">
      <div class="container">
        <header class="section-head reveal">
          <p class="section-kicker">Beyond the IDE</p>
          <h2 class="section-lead">Beyond Coding</h2>
          <p class="section-desc">
            Writing features is only part of it — a lot of the job is process, data, and people.
          </p>
        </header>
        <div class="row">
          {beyondCoding.map((item) => (
            <div class="col-md-6 col-lg-4 mb-4 reveal">
              <div class="skill-box h-100">
                <h3>{item.title}</h3>
                <div class="small-muted">{item.text}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="how-i-work">
      <div class="container">
        <header class="section-head reveal">
          <p class="section-kicker">Process</p>
          <h2 class="section-lead">How I Work</h2>
          <p class="section-desc">I like understanding the problem before locking in a technical approach.</p>
        </header>
        <div class="hero-card work-process reveal">
          <div class="work-steps" aria-label="Work process">
            <span class="work-step">Understand</span>
            <span class="work-step-arrow" aria-hidden="true">→</span>
            <span class="work-step">Build</span>
            <span class="work-step-arrow" aria-hidden="true">→</span>
            <span class="work-step">Check</span>
            <span class="work-step-arrow" aria-hidden="true">→</span>
            <span class="work-step">Ship</span>
            <span class="work-step-arrow" aria-hidden="true">→</span>
            <span class="work-step">Fix</span>
          </div>
          <div class="work-copy">
            <p>
              I aim for something the team can actually use and maintain — not just something that demos well once.
            </p>
            <p>
              Fine taking a feature from “we need this” through development, testing help, deploy support, and later
              tweaks when real usage shows gaps.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="education">
      <div class="container">
        <header class="section-head reveal">
          <p class="section-kicker">Background</p>
          <h2 class="section-lead">Education</h2>
          <p class="section-desc">Degree plus professional training.</p>
        </header>

        <div class="row">
          {education.map((e) => (
            <div class="col-md-4 mb-4 reveal">
              <div class="hero-card h-100 edu-card">
                <div class="edu-card-top">
                  <div class="small-muted">Education</div>
                  <div class="chip">{e.time}</div>
                </div>
                <h3 class="item-title">{e.degree}</h3>
                <div class="small-muted" style="margin-top:4px;">{e.org}</div>
              </div>
            </div>
          ))}
          {training.map((e) => (
            <div class="col-md-4 mb-4 reveal">
              <div class="hero-card h-100 edu-card">
                <div class="edu-card-top">
                  <div class="small-muted">Professional training</div>
                  <div class="chip">{e.time}</div>
                </div>
                <h3 class="item-title">{e.degree}</h3>
                <div class="small-muted" style="margin-top:4px;">{e.org}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section cta-band" id="hire">
      <div class="container reveal">
        <p class="section-eyebrow">Start here</p>
        <h2 class="cta-title">
          Bring me the problem.<br />
          I’ll help ship a fix.
        </h2>
        <p class="section-subtitle" style="margin-bottom:20px;">
          A slow report, an ops process stuck in spreadsheets, an ERP or integration that keeps breaking, a server
          setup that needs someone who’s lived in production. Tell me what you’re trying to fix.
        </p>
        <div class="hero-actions">
          <a class="btn-primary-neo" href={`mailto:${profile.email}`}>Email me</a>
          <a class="btn-ghost" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a class="btn-ghost" href={profile.resumeUrl} target="_blank" rel="noopener noreferrer">View Resume</a>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="contact">
      <div class="container">
        <header class="section-head reveal">
          <p class="section-kicker">Contact</p>
          <h2 class="section-lead">Let’s talk</h2>
          <p class="section-desc">Recruiter, tech lead, or founder — skip the long pitch and say what you need.</p>
        </header>

        <div class="row g-4">
          <div class="col-lg-5 reveal">
            <div class="hero-card">
              <div class="contact-line">
                <span class="small-muted">Email</span>
                <a href={`mailto:${profile.email}`}>{profile.email}</a>
              </div>
              <div class="contact-line">
                <span class="small-muted">Phone</span>
                <span>{profile.phone}</span>
              </div>
              <div class="contact-line">
                <span class="small-muted">LinkedIn</span>
                <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">linkedin.com/in/sshanto13</a>
              </div>
              <div class="contact-line">
                <span class="small-muted">GitHub</span>
                <a href={profile.links.github} target="_blank" rel="noopener noreferrer">github.com/sshanto13</a>
              </div>
              <div class="contact-line" style="margin-bottom:0;">
                <span class="small-muted">Location</span>
                <span>{profile.location}</span>
              </div>
            </div>
          </div>
          <div class="col-lg-7 reveal">
            <div class="hero-card">
              <h3 class="item-title" style="margin-bottom:12px;">Where I’m Most Useful</h3>
              <ul class="useful-list">
                {usefulFor.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-start gap-2">
      <div>
        <div style="font-weight:800;">{profile.name}</div>
        <div class="small-muted">IT &amp; Digitalization · {profile.location}</div>
      </div>
      <div class="small-muted">© {year}</div>
    </div>
  </footer>
</BaseLayout>

<script>
  const dialog = document.getElementById('moreProjects') as HTMLDialogElement | null;
  const openBtns = document.querySelectorAll('[data-open-projects]');
  let lastBtn: HTMLElement | null = null;
  if (dialog && openBtns.length) {
    openBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        lastBtn = btn as HTMLElement;
        dialog.showModal();
        document.documentElement.classList.add('modal-open');
      }),
    );
    dialog.querySelector('[data-close-projects]')?.addEventListener('click', () => dialog.close());
    // Click on the backdrop (outside the inner panel) closes the dialog.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('modal-open');
      lastBtn?.focus();
    });
  }
</script>

<script>
  const lb = document.getElementById('lightbox') as HTMLDialogElement | null;
  const popup = document.getElementById('moreProjects');
  if (lb && popup) {
    const img = document.getElementById('lightboxImg') as HTMLImageElement;
    const titleEl = document.getElementById('lightboxTitle')!;
    const labelEl = document.getElementById('lightboxLabel')!;
    const countEl = document.getElementById('lightboxCount')!;
    const liveEl = document.getElementById('lightboxLive') as HTMLAnchorElement;
    const items = Array.from(popup.querySelectorAll<HTMLElement>('[data-lightbox]'));
    let current = 0;

    const read = (el: HTMLElement) => {
      const card = el.closest('.project-card');
      return {
        src: (el.querySelector('img') as HTMLImageElement).currentSrc || (el.querySelector('img') as HTMLImageElement).src,
        title: card?.querySelector('.project-card-title')?.textContent?.trim() ?? '',
        label: card?.querySelector('.project-card-company')?.textContent?.trim() ?? '',
        live: el.dataset.live || '',
      };
    };

    const show = (i: number) => {
      current = (i + items.length) % items.length;
      const d = read(items[current]);
      img.src = d.src;
      img.alt = `${d.title} screenshot`;
      titleEl.textContent = d.title;
      labelEl.textContent = d.label;
      countEl.textContent = `${current + 1} / ${items.length}`;
      if (d.live) {
        liveEl.href = d.live;
        liveEl.hidden = false;
      } else {
        liveEl.hidden = true;
      }
      // Warm the cache for the neighbours so arrow navigation feels instant.
      [current - 1, current + 1].forEach((n) => {
        const nb = items[(n + items.length) % items.length];
        const pre = new Image();
        pre.src = read(nb).src;
      });
    };

    const open = (i: number) => {
      show(i);
      if (!lb.open) lb.showModal();
    };

    items.forEach((el, i) => {
      el.addEventListener('click', () => open(i));
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(i);
        }
      });
    });

    lb.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(current - 1));
    lb.querySelector('[data-lb-next]')?.addEventListener('click', () => show(current + 1));
    lb.querySelector('[data-lb-close]')?.addEventListener('click', () => lb.close());
    lb.addEventListener('click', (e) => {
      if (e.target === lb) lb.close();
    });
    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // Swipe left / right on touch screens.
    let startX = 0;
    lb.addEventListener('touchstart', (e) => (startX = e.changedTouches[0].clientX), { passive: true });
    lb.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );
  }
</script>
